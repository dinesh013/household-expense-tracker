# Copy to .env and fill in from Supabase: Project Settings -> API.
# Only the public URL and the anon (or "publishable") key belong here. They are safe in the browser
# because Row Level Security guards every table. NEVER put the service_role / secret key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
